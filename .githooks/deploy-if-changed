#!/usr/bin/env bash
# 被 post-commit / post-merge 调用：$1 是改动前的提交（空 = 这是第一个提交）。
# 只要在 main 上、这段改动碰了 index.html、flow.js 或 server/，就在后台把 HEAD 部署到 roosterpi。
# 日志：.git/deploy.log。部署失败会弹 macOS 通知。跳过一次：FC_NO_DEPLOY=1 git ...
[ -n "${FC_NO_DEPLOY:-}" ] && exit 0
[ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] || exit 0
before=${1:-}
if [ -n "$before" ] && git rev-parse -q --verify "$before^{commit}" >/dev/null; then
  [ "$(git rev-parse "$before")" = "$(git rev-parse HEAD)" ] && exit 0
  changed=$(git diff --name-only "$before" HEAD)
else
  changed=$(git ls-tree -r --name-only HEAD)
fi
echo "$changed" | grep -qE '^(index\.html|flow\.js|server/)' || exit 0

root=$(git rev-parse --show-toplevel)
gitdir=$(cd "$(git rev-parse --git-common-dir)" && pwd)
log="$gitdir/deploy.log" lock="$gitdir/deploy.lock"
sha=$(git rev-parse --short HEAD)
echo "🚀 部署 $sha 到 fullcircle.roosterwho.com（后台进行，日志：.git/deploy.log）"

notify() {  # 标题 正文
  command -v osascript >/dev/null || return 0
  osascript -e "display notification \"$2\" with title \"$1\" sound name \"Basso\"" >/dev/null 2>&1 || true
}
(
  # 同一时间只跑一个部署；前一个没跑完就等它（最多 3 分钟）
  for _ in $(seq 180); do mkdir "$lock" 2>/dev/null && break; sleep 1; done
  trap 'rmdir "$lock" 2>/dev/null' EXIT
  echo "=== $(date '+%F %T') $sha"
  if "$root/server/deploy.sh"; then
    echo "OK $sha"
  else
    echo "FAILED $sha"
    notify "甲方要圆：部署失败" "$sha 没能部署到 roosterpi，详情看 .git/deploy.log"
  fi
) >> "$log" 2>&1 < /dev/null &
disown 2>/dev/null || true
exit 0

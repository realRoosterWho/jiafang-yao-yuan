#!/usr/bin/env bash
# main 上的提交只要动了 index.html 或 server/，就在后台把 HEAD 部署到 roosterpi。
# 输出写到 .git/deploy.log。跳过一次：FC_NO_DEPLOY=1 git commit ...
[ -n "${FC_NO_DEPLOY:-}" ] && exit 0
[ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] || exit 0
changed=$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null; git rev-parse -q --verify HEAD~1 >/dev/null || git ls-tree -r --name-only HEAD)
echo "$changed" | grep -qE '^(index\.html|server/)' || exit 0
root=$(git rev-parse --show-toplevel)
log="$(git rev-parse --git-common-dir)/deploy.log"
sha=$(git rev-parse --short HEAD)
echo "🚀 部署 $sha 到 fullcircle.roosterwho.com（后台进行，日志：.git/deploy.log）"
( echo "=== $(date '+%F %T') $sha"; "$root/server/deploy.sh" && echo "OK $sha" || echo "FAILED $sha" ) >> "$log" 2>&1 < /dev/null &
disown 2>/dev/null || true
exit 0
